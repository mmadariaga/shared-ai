{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "permission": {
    "external_directory": {
      "~/.config/opencode/sai/**": "allow"
    },
    "read": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    }
  }
}
