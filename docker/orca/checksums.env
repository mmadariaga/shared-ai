# Orca release pins — single source of truth for the image build (sourced by the Dockerfile).
# Committed, validated set for the default architecture x86_64 (amd64): the first
# build works unchanged on amd64 targets.
# arm64 builds require ORCA_ARCH=arm64 plus the matching ORCA_SHA256 (see README);
# the TARGETARCH match check enforces the pairing and fails the build otherwise.
ORCA_VERSION=v1.4.177
ORCA_ARCH=x86_64
ORCA_SHA256=7ce9016ef99105ad134f4d17497f2840716e87b8a2e76a304e07b9134c3728bc
